{
  "name": "happs-nodejs",
  "version": "1.1.1",
  "description": "Node.js client for Hooligapps Bridge API",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "require": "./client.js",
      "default": "./client.js"
    },
    "./oidc": {
      "types": "./oidc.d.ts",
      "require": "./oidc.js",
      "default": "./oidc.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "oidc.js",
    "oidc.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hooligapps/happs-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/hooligapps/happs-nodejs/issues"
  },
  "homepage": "https://github.com/hooligapps/happs-nodejs#readme",
  "dependencies": {
    "jose": "^6.2.2",
    "openid-client": "^6.8.1"
  },
  "license": "MIT"
}
